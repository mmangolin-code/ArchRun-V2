{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: debug local",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "jinja": true
    }
  ]
}
